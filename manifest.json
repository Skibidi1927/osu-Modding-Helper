{
  "manifest_version": 3,
  "name": "Karin's osu! Modding Helper",
  "version": "1.2",
  "key": "",
  "action": {
    "default_popup": "popup.html"
  },
  "description": "QoL extension for osu! discussion pages: s-ul uploads, markdown tools, duplicate checking, and BN frameworks.",
  "permissions": [
    "storage",
    "clipboardRead",
    "identity"
  ],
  "host_permissions": [
    "*://osu.ppy.sh/*",
    "*://s-ul.eu/*",
    "https://osu-proxy.yourname.workers.dev/*"
  ],
  "background": {
    "service_worker": "external_web_handler.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://osu.ppy.sh/beatmapsets/*/discussion*"
      ],
      "css": [
        "discussion_styles.css"
      ],
      "js": [
        "discussion_stuff/feature_settings.js",
        "discussion_stuff/discussion_download.js",
        "discussion_stuff/header_metadata.js",
        "discussion_stuff/toolbar_injector.js",
        "discussion_stuff/image_uploader.js",
        "discussion_stuff/toggled_RC_book.js",
        "discussion_stuff/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
